---
import '../styles/global.css';
interface Props { title?: string; description?: string; section?: string; image?: string | null }
const { title, description = 'Tech, homelab and homestead reviews and build notes from Stephenville, Texas.', section = '', image } = Astro.props;
const full = title ? `${title} | FarmNerds` : 'FarmNerds | Tech, homelab and homestead';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image || '/logo.png', Astro.site);
const nav = [
  ['latest', 'Latest', '/', ''],
  ['reviews', 'Reviews', '/reviews/', 'c-fl'],
  ['tech', 'Tech', '/tech/', 'c-tech'],
  ['homelab', 'Homelab', '/homelab/', 'c-lab'],
  ['homestead', 'Homestead', '/homestead/', 'c-stead'],
  ['farmlabs', 'FarmLabs', '/farmlabs/', 'c-fl'],
  ['about', 'About', '/about/', ''],
  ['support', 'Support', '/support/', ''],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="FarmNerds" href="/rss.xml" />
  <meta property="og:site_name" content="FarmNerds" />
  <meta property="og:title" content={title || 'FarmNerds'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <header>
    <div class="wrap mast">
      <a class="brand" href="/" aria-label="FarmNerds home">
        <span class="logo-mark"></span>
        <span><b>FARM<i>NERDS</i></b><small>tech · homelab · homestead</small></span>
      </a>
    </div>
    <nav class="sec" aria-label="Sections"><div class="wrap">
      {nav.map(([key, label, href, cls]) => <a href={href} class:list={[cls, { on: section === key }]}>{label}</a>)}
    </div></nav>
  </header>
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">
    <em>Powered by brisket, bandwidth, and bad ideas that work.</em>
    <span>FarmNerds © {new Date().getFullYear()} · Stephenville, Texas · <a href="/about/">About</a> · <a href="/support/">Support</a> · <a href="/rss.xml">RSS</a></span>
  </div></footer>
  <script>
    /* Placeholder artwork: circuit traces that drop from the top like the logo's roots. Used when a post has no photo. */
    function rng(s: number) { return () => { s |= 0; s = (s + 0x6d2b79f5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
    function draw(c: HTMLCanvasElement) {
      const w = c.clientWidth, h = c.clientHeight; if (!w || !h) return;
      const d = Math.min(devicePixelRatio || 1, 2); c.width = w * d; c.height = h * d;
      const x = c.getContext('2d')!; x.scale(d, d);
      const cs = getComputedStyle(c), col = cs.getPropertyValue('--c').trim() || cs.getPropertyValue('--teal').trim(), bg = cs.getPropertyValue('--art-bg').trim();
      x.fillStyle = bg; x.fillRect(0, 0, w, h);
      const g = x.createRadialGradient(w * 0.5, 0, 0, w * 0.5, 0, Math.max(w, h) * 0.9); g.addColorStop(0, col); g.addColorStop(1, 'transparent');
      x.globalAlpha = 0.22; x.fillStyle = g; x.fillRect(0, 0, w, h);
      const r = rng(+(c.dataset.seed || 1)), n = +(c.dataset.n || 0) || Math.max(7, Math.round(w / 34)), u = Math.max(8, Math.min(w, h) / 14);
      x.strokeStyle = col; x.lineJoin = 'round'; x.lineCap = 'round';
      for (let i = 0; i < n; i++) {
        let px = w * (0.5 + (i / (n - 1) - 0.5) * 0.5) + (r() - 0.5) * u, py = -2; const dir = i < n / 2 ? -1 : 1, end = h * (0.45 + r() * 0.5);
        x.globalAlpha = 0.35 + r() * 0.5; x.lineWidth = 1.2 + r() * 1.6; x.beginPath(); x.moveTo(px, py);
        while (py < end) { const v = u * (0.6 + r() * 1.6); py = Math.min(end, py + v); x.lineTo(px, py);
          if (py < end && r() < 0.8) { const s = u * (0.5 + r() * 1.4), dd = r() < 0.82 ? dir : -dir; px += s * dd; py += s; x.lineTo(px, py); } }
        x.stroke(); x.beginPath(); x.arc(px, py + 4, 3.2, 0, 7); x.fillStyle = bg; x.globalAlpha = 1; x.fill(); x.globalAlpha = 0.9; x.lineWidth = 1.6; x.stroke();
      }
    }
    const arts = [...document.querySelectorAll<HTMLCanvasElement>('canvas.art')];
    const ro = new ResizeObserver((es) => es.forEach((e) => draw(e.target as HTMLCanvasElement)));
    arts.forEach((c) => ro.observe(c));
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => arts.forEach(draw));
  </script>
</body>
</html>
