---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
// The wording lives in src/content/pages/about.md and is edited from /admin (Pages).
const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(page);
const { label, title, description, buttons } = page.data;
---
<Base title={label || title} description={description} section="about">
  <div class="stack">
    <div class="pagehead"><span class="chip">{label}</span><h1>{title}</h1></div>
    <div class="md"><Content /></div>
    {buttons?.length ? (
      <div class="btns">
        {buttons.map((b, i) => <a class={i % 2 ? 'btn alt' : 'btn'} href={b.url} target="_blank" rel="noopener">{b.label}</a>)}
      </div>
    ) : null}
  </div>
</Base>
